# Copy to .env and replace every placeholder. Never commit .env.
# Avoid characters like @ : / # ? % in passwords (they are interpolated into URLs).

ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=agentos
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=agentos

# --- Neo4j (password must be at least 8 characters) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=60

# --- Model providers (leave empty to run simulated agents only) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional extra OpenAI model ids, comma separated
OPENAI_EXTRA_MODELS=
# Optional pricing, JSON, USD per million tokens. Empty = cost not estimated.
# Example: {"anthropic:claude-sonnet-5-5":{"input_per_mtok":0,"output_per_mtok":0}}
PRICING_JSON=

# --- Web ---
CORS_ORIGINS=http://localhost:3000
# URL the BROWSER uses to reach the API (baked into the frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
